# Copy this file to .env (and never commit the real .env) for local runs,
# or paste these as environment variables in your hosting provider's dashboard.

SECRET_KEY=generate-a-long-random-string

# Leave unset locally to use SQLite. In production set to your Postgres URL
# (Render/Azure/PythonAnywhere all provide one).
DATABASE_URL=

TOTAL_SEATS=300
SEAT_PRICE_EUR=4.00
SEAT_HOLD_MINUTES=7

ADMIN_EMAIL=admin@szpm.mt
ADMIN_PASSWORD=change-this-before-deploying

# Stripe (from https://dashboard.stripe.com/apikeys and /webhooks)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Microsoft 365 / Outlook SMTP - use a mailbox + an App Password
# (Outlook > Settings > "App passwords", requires MFA enabled on the account)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=fireworks@szpm.mt
SMTP_PASSWORD=your-app-password
MAIL_FROM_NAME=Festa Munxar - Fireworks Booking
TEAM_NOTIFY_EMAILS=brendon.spiteri@szpm.mt,committee@szpm.mt

# Public URL of the deployed site (used in Stripe redirect links and emails)
BASE_URL=https://your-app-name.onrender.com

# Optional: real Apple Wallet / Google Wallet passes via the third-party
# WalletWallet.dev API (sign up at https://www.walletwallet.dev). Leave blank
# to skip - the QR code + PDF ticket always work regardless.
WALLETWALLET_API_KEY=
